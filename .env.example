# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
BOT_TOKEN=
# Optional: a server id to instantly sync commands to while developing.
TEST_GUILD_ID=
# Optional: your Discord user id (for owner-only checks).
BOT_DEV=

# ─── Clash of Clans API ───────────────────────────────────────────────────────
# Your developer-site login (https://developer.clashofclans.com). On startup the
# bot logs in and automatically creates/rotates an IP-locked API key for THIS
# host — so hosting on Railway (where the IP can change on redeploy) just works.
# No manual key creation needed.
COC_EMAIL=
COC_PASSWORD=

# ─── Database (Supabase / Postgres) ───────────────────────────────────────────
# Your Supabase connection string. In Supabase: Project Settings → Database →
# Connection string → "Connection pooling" (URI, port 6543). Example:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Optional ─────────────────────────────────────────────────────────────────
SUPPORT_SERVER=https://discord.gg/
POLL_INTERVAL_SECONDS=60
