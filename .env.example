# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) id — same page as the token
CLIENT_ID=
# Optional: a guild id to register commands to instantly during development.
# Leave empty to deploy commands globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# ─── Clash of Clans API ───────────────────────────────────────────────────────
# API key(s) from https://developer.clashofclans.com — comma-separate multiple keys.
# NOTE: keys are IP-locked to the IP you created them from.
CLASH_API_TOKENS=
# Alternatively, log in with your developer account and the bot will mint/rotate
# IP-locked keys automatically for the current host (recommended for dynamic IPs).
CLASH_API_EMAIL=
CLASH_API_PASSWORD=

# ─── Databases ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=argon
REDIS_URL=redis://localhost:6379

# ─── Bot behaviour ────────────────────────────────────────────────────────────
# Number of shards/clusters to spawn ("auto" lets discord.js decide).
TOTAL_SHARDS=auto
SHARDS_PER_CLUSTER=8
# Default embed color (hex, no leading #).
EMBED_COLOR=5865F2
# Support server / invite links surfaced by /invite and /help.
SUPPORT_SERVER=https://discord.gg/
# How often (seconds) the background scheduler polls clans for feeds & reminders.
POLL_INTERVAL_SECONDS=60
# Log level: debug | info | warn | error
LOG_LEVEL=info
