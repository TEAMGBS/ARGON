# ─── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) id — same page as the token
CLIENT_ID=
# Optional: a guild id to register commands to instantly during development.
# Leave empty to deploy commands globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# ─── Clash of Clans API ───────────────────────────────────────────────────────
# RECOMMENDED: log in with your developer-site account (the same email/password you
# use at https://developer.clashofclans.com). On every boot the bot detects this
# host's outbound IP and automatically creates/rotates an IP-locked API key for it —
# so hosting on Railway (where the IP can change on redeploy) just works. No manual
# key creation needed.
CLASH_API_EMAIL=
CLASH_API_PASSWORD=
# Optional: how many keys to mint (each allows more requests/sec). 1 is plenty to start.
CLASH_API_KEY_COUNT=1
CLASH_API_KEY_NAME=argon-bot

# ALTERNATIVE (fixed-IP hosts only): pre-created API key(s) from the developer site,
# comma-separated. Leave blank if you use the email/password login above.
CLASH_API_TOKENS=

# ─── Databases ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=argon
REDIS_URL=redis://localhost:6379

# ─── Bot behaviour ────────────────────────────────────────────────────────────
# Number of shards/clusters to spawn ("auto" lets discord.js decide).
TOTAL_SHARDS=auto
SHARDS_PER_CLUSTER=8
# Default embed color (hex, no leading #).
EMBED_COLOR=5865F2
# Support server / invite links surfaced by /invite and /help.
SUPPORT_SERVER=https://discord.gg/
# How often (seconds) the background scheduler polls clans for feeds & reminders.
POLL_INTERVAL_SECONDS=60
# Log level: debug | info | warn | error
LOG_LEVEL=info
