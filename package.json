{
  "name": "argon",
  "version": "1.0.0",
  "description": "ARGON — a feature-rich Clash of Clans Discord bot (ClashPerk-style replica).",
  "type": "module",
  "main": "dist/bot/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "node dist/bot/index.js",
    "dev": "tsx watch --clear-screen=false src/bot/index.ts",
    "deploy": "tsx scripts/deploy-commands.ts",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "clash-of-clans",
    "discord",
    "discord-bot",
    "clashperk",
    "coc"
  ],
  "license": "MIT",
  "dependencies": {
    "clashofclans.js": "^4.0.0",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "i18next": "^23.15.1",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "moment-timezone": "^0.5.46",
    "mongodb": "^6.9.0",
    "nanoid": "^5.0.7",
    "radash": "^12.1.0",
    "readdirp": "^4.0.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0"
  },
  "devDependencies": {
    "@types/moment-duration-format": "^2.2.6",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
